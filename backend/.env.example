# Copy to .env and adjust. Never commit real credentials.
BI_ENVIRONMENT=development
BI_LOG_LEVEL=INFO
BI_DATABASE_URL=sqlite+aiosqlite:///./bitcoin_intelligence.db
# BI_DATABASE_URL=postgresql+asyncpg://bi:CHANGE_ME@localhost:5432/bitcoin_intelligence
BI_PROVIDERS=["mempool","blockstream"]
BI_INGESTION_ENABLED=true
BI_INGESTION_INTERVAL_S=60
BI_INGESTION_BACKFILL_BLOCKS=144
BI_RATE_LIMIT_PER_MINUTE=240
# Whale Tracker
BI_WHALE_TRACKING_ENABLED=true
BI_WHALE_MIN_BTC=100
BI_WHALE_TIERS_BTC=[100,1000,10000]
# Required outside development to allow write operations (alert rules).
# BI_ADMIN_API_KEY=
